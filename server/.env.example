# ──────────────────────────────────────────────────────────────────────────────
# server/.env.example
# Copy to server/.env for local development.
# Production values are injected via EC2 user-data from Terraform variables.
# ──────────────────────────────────────────────────────────────────────────────

# Database
# Local:      postgres://postgres:postgres@localhost:5432/motionmesh?sslmode=disable
# Production: postgres://<user>:<pass>@<aurora-endpoint>:5432/<db>?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/motionmesh?sslmode=disable

# Redis
# Local:      redis://localhost:6379/0
# Production: redis://<elasticache-primary-endpoint>:6379/0
REDIS_URL=redis://localhost:6379/0

# NATS JetStream
# Local:      nats://localhost:4222
# Production: nats://<nats-instance-private-ip>:4222
QUEUE_URL=nats://localhost:4222

# Object Storage — AWS S3
# In production the EC2 IAM instance profile is used automatically (no keys needed).
# For local development, set AWS credentials via environment or ~/.aws/credentials.
STORAGE_BUCKET=motionmesh-dev
STORAGE_REGION=ap-south-1

# Auth — JWT signing secret (generate with: openssl rand -hex 64)
JWT_SECRET=your_jwt_secret

# Clerk (dashboard auth)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# JWKS endpoint for networkless JWT verification (from Clerk dashboard → API Keys)
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# Stripe
STRIPE_SECRET_KEY=sk_test_REDACTED
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Gemini (optional — for AI features)
HUGGINGFACE_API_KEY=

# Captions sidecar
# Local:      http://localhost:8000
# Production: http://<captions-instance-private-ip>:8000
CAPTIONS_SIDECAR_URL=http://localhost:8000

# CORS allowed origins (comma-separated)
# Production: https://motionmesh.co.in,https://www.motionmesh.co.in
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
