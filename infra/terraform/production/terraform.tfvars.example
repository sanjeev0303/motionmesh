# ──────────────────────────────────────────────────────────────────────────────
# terraform.tfvars.example
# Copy to terraform.tfvars and fill in real values.
# Never commit terraform.tfvars to source control.
# ──────────────────────────────────────────────────────────────────────────────

# AWS region
aws_region = "ap-south-1"

# Domains (Route 53 hosted zone must already exist for domain_name)
domain_name = "motionmesh.co.in"
api_domain  = "api.motionmesh.co.in"

# VPC
vpc_cidr = "10.20.0.0/16"
azs      = ["ap-south-1a", "ap-south-1b"]

# Aurora PostgreSQL
db_name     = "motionmesh"
db_username = "Motionmesh_db_admin"
db_password = "<your_db_password_here>"

# Application secrets (generate with: openssl rand -hex 64)
clerk_publishable_key = "<your_clerk_publishable_key_here>"
jwt_secret            = "<your_jwt_secret_here>"
clerk_secret_key      = "<your_clerk_secret_key_here>"
clerk_jwks_url        = "https://motionmesh.clerk.accounts.dev/.well-known/jwks.json"
stripe_secret_key     = "<your_stripe_secret_key_here>"
stripe_webhook_secret = "<your_stripe_webhook_secret_here>"
gemini_api_key        = "<your_gemini_api_key_here>"

# GitHub repository to clone on EC2 boot
github_repository = "https://github.com/sanjeev0303/motionmesh.git"
github_branch     = "main"

# Instance types (adjust for cost vs. performance)
api_instance_type      = "t3.medium"
worker_instance_type   = "t3.large"
worker_count           = 1
dashboard_instance_type = "t3.small"
nats_instance_type     = "t3.small"
captions_instance_type = "t3.xlarge"

# Aurora & Redis instance classes
aurora_instance_class = "db.t4g.medium"
redis_node_type       = "cache.t4g.small"

# EC2 key pair (optional — use SSM Session Manager if left empty)
key_name = ""
