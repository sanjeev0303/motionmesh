#!/bin/bash
set -euo pipefail

apt-get update -y
fallocate -l 4G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=4096
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab

apt-get install -y ca-certificates curl gnupg unzip git

# ─── Docker ───────────────────────────────────────────────────────────────────
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
  https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
  > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin
systemctl enable --now docker

# ─── CloudWatch agent ─────────────────────────────────────────────────────────
curl -fsSL https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb \
  -o /tmp/cwa.deb
dpkg -i /tmp/cwa.deb

cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << 'CWA'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/motionmesh-captions.log",
            "log_group_name": "/motionmesh/captions",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWA
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s

# ─── Clone repository ─────────────────────────────────────────────────────────
mkdir -p /opt/motionmesh
git clone --depth 1 --branch ${github_branch} ${github_repository} /opt/motionmesh
cd /opt/motionmesh

# ─── Build captions-sidecar image (downloads faster-whisper model at build time) ─
docker build \
  --build-arg BUILDKIT_INLINE_CACHE=1 \
  -f server/captions-sidecar/Dockerfile \
  -t motionmesh-captions:latest \
  ./server

cat > /etc/systemd/system/motionmesh-captions.service << 'UNIT'
[Unit]
Description=MotionMesh Captions Sidecar
After=docker.service network-online.target
Requires=docker.service

[Service]
Restart=always
RestartSec=10s
# 4 GB memory limit matches docker-compose.yml mem_limit
ExecStartPre=-/usr/bin/docker rm -f motionmesh-captions
ExecStart=/usr/bin/docker run --rm \
  --name motionmesh-captions \
  --memory 4g \
  -p 8000:8000 \
  -e HUGGINGFACE_API_KEY=${huggingface_api_key} \
  --log-driver awslogs \
  --log-opt awslogs-region=${aws_region} \
  --log-opt awslogs-group=/motionmesh/captions \
  motionmesh-captions:latest
ExecStop=/usr/bin/docker stop motionmesh-captions

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now motionmesh-captions

echo "Waiting for Captions Sidecar to become healthy on port 8000..."
for i in {1..30}; do
  if curl -sf http://127.0.0.1:8000/health >/dev/null; then
    echo "Captions Sidecar is healthy locally."
    exit 0
  fi
  echo "Retrying... ($i/30)"
  sleep 5
done
echo "Captions Sidecar failed to become healthy within timeout!" >&2
exit 1
