#!/bin/bash
set -euo pipefail

apt-get update -y
fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab

apt-get install -y ca-certificates curl gnupg unzip git

# ─── Docker ───────────────────────────────────────────────────────────────────
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
  https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
  > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin
systemctl enable --now docker

# ─── CloudWatch agent ─────────────────────────────────────────────────────────
curl -fsSL https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb \
  -o /tmp/cwa.deb
dpkg -i /tmp/cwa.deb

cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << 'CWA'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/motionmesh-dashboard.log",
            "log_group_name": "/motionmesh/dashboard",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWA
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s

# ─── Clone repository ─────────────────────────────────────────────────────────
mkdir -p /opt/motionmesh
git clone --depth 1 --branch ${github_branch} ${github_repository} /opt/motionmesh
cd /opt/motionmesh

# ─── Build dashboard image ────────────────────────────────────────────────────
# NEXT_PUBLIC_* variables are baked at build time; pass them as build args.
docker build \
  --build-arg BUILDKIT_INLINE_CACHE=1 \
  --build-arg NEXT_PUBLIC_API_URL=${next_public_api_url} \
  --build-arg NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${next_public_clerk_publishable_key} \
  --build-arg NEXT_PUBLIC_MOTIONMESH_BUCKET_ID=${next_public_motionmesh_bucket_id} \
  --build-arg NEXT_PUBLIC_MOTIONMESH_TRANSCODE_BUCKET_ID=${next_public_motionmesh_transcode_bucket_id} \
  -f client/dashboard/Dockerfile \
  -t motionmesh-dashboard:latest \
  .

cat > /etc/systemd/system/motionmesh-dashboard.service << 'UNIT'
[Unit]
Description=MotionMesh Dashboard
After=docker.service network-online.target
Requires=docker.service

[Service]
Restart=always
RestartSec=10s
ExecStartPre=-/usr/bin/docker rm -f motionmesh-dashboard
ExecStart=/usr/bin/docker run --rm \
  --name motionmesh-dashboard \
  -p 3000:3000 \
  -e NODE_ENV=production \
  -e NEXT_PUBLIC_API_URL=${next_public_api_url} \
  -e NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${next_public_clerk_publishable_key} \
  -e CLERK_SECRET_KEY=${clerk_secret_key} \
  -e NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login \
  -e NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup \
  -e NEXT_PUBLIC_MOTIONMESH_BUCKET_ID=${next_public_motionmesh_bucket_id} \
  -e NEXT_PUBLIC_MOTIONMESH_TRANSCODE_BUCKET_ID=${next_public_motionmesh_transcode_bucket_id} \
  -e MOTIONMESH_API_KEY=mot_live_c16fea33816e10f3.70c083f8d0c36e8878fc7756a5f8a5289c009937a007201fc03413507f664161 \
  -e MOTIONMESH_BASE_URL=${next_public_api_url}/v1 \
  --log-driver awslogs \
  --log-opt awslogs-region=${aws_region} \
  --log-opt awslogs-group=/motionmesh/dashboard \
  motionmesh-dashboard:latest
ExecStop=/usr/bin/docker stop motionmesh-dashboard

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now motionmesh-dashboard

echo "Waiting for Dashboard to become healthy on port 3000..."
for i in {1..30}; do
  if curl -sf http://127.0.0.1:3000/ >/dev/null; then
    echo "Dashboard is healthy locally."
    exit 0
  fi
  echo "Retrying... ($i/30)"
  sleep 5
done
echo "Dashboard failed to become healthy within timeout!" >&2
exit 1
