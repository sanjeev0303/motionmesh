#!/bin/bash
set -euo pipefail

apt-get update -y
fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab

apt-get install -y ca-certificates curl gnupg unzip git

# ─── Docker ───────────────────────────────────────────────────────────────────
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
  https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
  > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin
systemctl enable --now docker

# ─── CloudWatch agent ─────────────────────────────────────────────────────────
curl -fsSL https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb \
  -o /tmp/cwa.deb
dpkg -i /tmp/cwa.deb

cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << 'CWA'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/motionmesh-worker.log",
            "log_group_name": "/motionmesh/worker",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
CWA
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s

# ─── Clone repository ─────────────────────────────────────────────────────────
mkdir -p /opt/motionmesh
git clone --depth 1 --branch ${github_branch} ${github_repository} /opt/motionmesh
cd /opt/motionmesh

# ─── Write environment file ───────────────────────────────────────────────────
cat > /opt/motionmesh/server/.env << 'ENVFILE'
DATABASE_URL=${database_url}
REDIS_URL=${redis_url}
QUEUE_URL=${nats_url}
STORAGE_BUCKET=${storage_bucket}
STORAGE_REGION=${aws_region}
JWT_SECRET=${jwt_secret}
CLERK_SECRET_KEY=${clerk_secret_key}
CLERK_JWKS_URL=${clerk_jwks_url}
STRIPE_SECRET_KEY=${stripe_secret_key}
STRIPE_WEBHOOK_SECRET=${stripe_webhook_secret}
HUGGINGFACE_API_KEY=${huggingface_api_key}
CAPTIONS_SIDECAR_URL=${captions_sidecar_url}
ENVFILE

# ─── Build and start worker container ─────────────────────────────────────────
docker build \
  --build-arg BUILDKIT_INLINE_CACHE=1 \
  -f server/worker/Dockerfile \
  -t motionmesh-worker:latest \
  ./server

cat > /etc/systemd/system/motionmesh-worker.service << 'UNIT'
[Unit]
Description=MotionMesh Worker
After=docker.service network-online.target
Requires=docker.service

[Service]
Restart=always
RestartSec=10s
ExecStartPre=-/usr/bin/docker rm -f motionmesh-worker
ExecStart=/usr/bin/docker run --rm \
  --name motionmesh-worker \
  --env-file /opt/motionmesh/server/.env \
  --log-driver awslogs \
  --log-opt awslogs-region=${aws_region} \
  --log-opt awslogs-group=/motionmesh/worker \
  motionmesh-worker:latest
ExecStop=/usr/bin/docker stop motionmesh-worker

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now motionmesh-worker
